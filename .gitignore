# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
build/
dist/
*.egg-info/

# Models - Our trained models WILL be pushed (needed for production)
# Trained models are essential for the app to work
models/*.pkl
models/*.pt
models/*.bin
# Allow our specific trained models
!models/classifier.pkl
!models/vectorizer.pkl
!models/lda_model.pkl
!models/lda_vectorizer.pkl
!models/lda_metadata.pkl
!models/classifier_metadata.pkl

# Hugging Face models - Downloaded on first run
.cache/
*.safetensors
transformers_cache/

# Data - Keep folder structure only
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Uploads - Don't push user uploads
uploads/*
!uploads/.gitkeep

# Environment files
.env

# IDE settings
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Database files
*.db
*.sqlite

# Development/Testing files (don't push)
test_*.py
test_*.txt
quick_*.py
VERIFY_SYSTEM.py
SYSTEM_STATUS.md
analyze_*.py
retrain_*.py
cleanup_*.py


